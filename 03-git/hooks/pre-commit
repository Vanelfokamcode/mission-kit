#!/usr/bin/env bash
DIR="$(dirname "$(readlink -f "$0")")"
source "$DIR/../lib.sh"

branch="$(current_branch)"
if [ -n "$branch" ] && is_protected "$branch"; then
  warn "BLOCKED: commit on protected branch '$branch'."
  warn "Create a branch first: git switch -c feature/<name>"
  exit 1
fi

bad="$(secret_files_staged)"
if [ -n "$bad" ]; then
  warn "BLOCKED: staged files look like secrets or state files:"
  printf '%s\n' "$bad" | sed 's/^/  /' >&2
  warn "Unstage them with: git restore --staged <file>"
  exit 1
fi
exit 0
